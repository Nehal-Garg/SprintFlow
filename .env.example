# SprintFlow Environment Configuration Example
# Copy this file to backend/.env and update values before running locally.

# Application
APP_NAME=SprintFlow
ENVIRONMENT=development

# Database (SQLite relative to backend/ working directory)
DATABASE_URL=sqlite:///./sprintflow.db

# Security (Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Background Deadline Reminder Workflow
DEADLINE_REMINDER_DAYS=2
BACKGROUND_MAX_RETRIES=3
BACKGROUND_RETRY_BASE_DELAY_SECONDS=0.2

# Frontend (create frontend/.env if overriding)
VITE_API_BASE_URL=http://localhost:8000
